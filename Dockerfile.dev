# Local development image: runs `ng serve` with hot reload.
# There is no production image for the frontend - `ng build` emits static files
# (angular.json sets outputMode "static") that get deployed straight to a CDN.
FROM node:22-alpine

WORKDIR /app

EXPOSE 4200

# node_modules is a named volume in docker-compose, so the host's Windows-built
# native binaries (esbuild in particular) never shadow the Linux ones installed
# here. Installing at start rather than at build time keeps the image valid
# across dependency changes.
CMD ["sh", "-c", "npm install --no-audit --no-fund && npx ng serve --host 0.0.0.0 --port 4200 --poll 2000"]
